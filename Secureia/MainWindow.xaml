<Window x:Class="Secureia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Secureia.Views"
        Title="Secure AI - Asistente de Seguridad" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F3460">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,25,20,20">
                    <Image Source="Assets/baner.png" MaxWidth="180" MaxHeight="60" Margin="0,0,0,12"
                           HorizontalAlignment="Left" Stretch="Uniform"/>
                    <TextBlock Text="Asistente de Seguridad" FontSize="12" Foreground="#888"/>
                    <TextBlock Text="Sistema Asegurado" FontSize="11" Foreground="#81C784" Margin="0,5,0,0"/>
                    <Border Background="#FFD700" CornerRadius="3" Padding="6,2" Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsPlusActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="PLUS" FontSize="10" FontWeight="Bold" Foreground="#1a1a2e"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="    Panel de Control" Command="{Binding ShowDashboardCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="    Escaneo" Command="{Binding ShowScanCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="    Historial" Command="{Binding ShowHistoryCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="    Cuarentena" Command="{Binding ShowQuarantineCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="    Configuración" Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource NavButton}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,0,20,20">
                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="White" Margin="0,0,0,5"/>
                    <TextBlock Text="Protección local con privacidad" FontSize="11" Foreground="White"/>
                    <TextBlock Text="Powered by Agdala 2026" FontSize="10" Foreground="#CCC" Margin="0,5,0,0"/>
                    <TextBlock Text="Contacto: agdala.sv@gmail.com" FontSize="10" Foreground="#AAA" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <views:DashboardView/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <views:DashboardView/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Scan">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <views:ScanView/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="History">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <views:HistoryView/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Quarantine">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <views:QuarantineView/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <views:SettingsView/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Window>
