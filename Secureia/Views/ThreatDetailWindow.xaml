<Window x:Class="Secureia.Views.ThreatDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Amenaza de Red" Height="520" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1a1a2e" Foreground="#E0E0E0"
        WindowStyle="SingleBorderWindow"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#16213E" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Detalles de la Amenaza de Red" FontSize="18" FontWeight="Bold" Foreground="#FF5252" Margin="0,0,0,10"/>

                <TextBlock Style="{StaticResource Label}" Text="Tipo de Amenaza:"/>
                <TextBlock x:Name="ThreatTypeText" Style="{StaticResource Value}" FontWeight="SemiBold" Foreground="#FFB74D"/>

                <TextBlock Style="{StaticResource Label}" Text="Nivel de Riesgo:"/>
                <TextBlock x:Name="ThreatLevelText" Style="{StaticResource Value}" FontWeight="Bold"/>

                <TextBlock Style="{StaticResource Label}" Text="Descripción:"/>
                <Border Background="#0F3460" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <TextBlock x:Name="DescriptionText" Style="{StaticResource Value}" Margin="0"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label}" Text="IP Origen:"/>
                        <TextBlock x:Name="SourceIpText" Style="{StaticResource Value}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Label}" Text="IP Destino:"/>
                        <TextBlock x:Name="DestIpText" Style="{StaticResource Value}"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Label}" Text="Puerto Origen:"/>
                        <TextBlock x:Name="SourcePortText" Style="{StaticResource Value}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Label}" Text="Puerto Destino:"/>
                        <TextBlock x:Name="DestPortText" Style="{StaticResource Value}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Label}" Text="Estado:"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Value}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#16213E" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Acción" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                <TextBlock Text="¿Esta amenaza es un falso positivo o desea proceder con la eliminación?" FontSize="13" Foreground="#CCC" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="Al eliminar la amenaza se bloqueará la IP asociada mediante el firewall de Windows." FontSize="12" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <WrapPanel HorizontalAlignment="Center" Margin="0,5,0,0">
                    <Button x:Name="MarkFalsePositiveBtn" Content="Es un falso positivo" 
                            Background="#4CAF50" Foreground="White" BorderThickness="0"
                            Padding="16,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#388E3C"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#2E7D32"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="EliminateBtn" Content="Eliminar amenaza"
                            Background="#FF5252" Foreground="White" BorderThickness="0"
                            Padding="16,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D32F2F"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#B71C1C"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CancelBtn" Content="Cerrar"
                            Background="#333" Foreground="#E0E0E0" BorderThickness="0"
                            Padding="16,10" FontSize="13" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#444"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#555"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ResultText" Grid.Row="2" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
</Window>