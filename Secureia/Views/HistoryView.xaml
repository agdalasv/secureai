<UserControl x:Class="Secureia.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="30,25,30,15">
            <TextBlock Text="Historial de eventos" FontSize="28" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Actualizar" Command="{Binding History.RefreshCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                <Button Content="Exportar" Command="{Binding History.ExportCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="Guardar en Documentos" Command="{Binding History.SaveToDocumentsCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="Carpeta del programa" Command="{Binding History.OpenAppFolderCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="Borrar registros" Command="{Binding History.ClearCommand}"
                         Style="{StaticResource DangerButton}"/>
            </StackPanel>
            <TextBlock Text="Las amenazas de red aparecen resaltadas en rojo. Haga doble clic para ver detalles y gestionar la amenaza (Secure AI Plus)."
                       FontSize="11" Foreground="#888" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsPlusActive, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#16213E" CornerRadius="12" Margin="30,0,30,30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#0F3460" CornerRadius="8" Margin="10,10,10,0">
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fecha/Hora" FontWeight="SemiBold" Foreground="#AAA" Grid.Column="0"/>
                        <TextBlock Text="Evento" FontWeight="SemiBold" Foreground="#AAA" Grid.Column="1"/>
                        <TextBlock Text="Archivo" FontWeight="SemiBold" Foreground="#AAA" Grid.Column="2"/>
                        <TextBlock Text="Acción" FontWeight="SemiBold" Foreground="#AAA" Grid.Column="3"/>
                        <TextBlock Text="Usuario" FontWeight="SemiBold" Foreground="#AAA" Grid.Column="4"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding History.Logs}" 
                          Background="Transparent" BorderThickness="0" Margin="10,0,10,10"
                          IsSynchronizedWithCurrentItem="True"
                          x:Name="LogListBox">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0"
                                                Padding="0" Margin="0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1a1a3e"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="MouseDoubleClick" Handler="ListBoxItem_MouseDoubleClick"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F3460" CornerRadius="6" Padding="10,8" Margin="0,2"
                                    BorderThickness="1"
                                    BorderBrush="{Binding IsNetworkThreat, Converter={StaticResource NetworkThreatBorderConverter}}"
                                    Cursor="{Binding IsNetworkThreat, Converter={StaticResource NetworkThreatCursorConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" 
                                               FontSize="12" Foreground="#CCC" Grid.Column="0"/>
                                    <TextBlock Text="{Binding Event}" FontSize="12" Foreground="#CCC" 
                                               Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FilePath}" FontSize="12" Foreground="#888" 
                                               Grid.Column="2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ActionTaken}" FontSize="12" Foreground="#4FC3F7" 
                                               Grid.Column="3"/>
                                    <TextBlock Text="{Binding User}" FontSize="12" Foreground="#888" Grid.Column="4"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
