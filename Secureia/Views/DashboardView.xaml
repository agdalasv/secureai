<UserControl x:Class="Secureia.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer Background="#1a1a2e">
        <StackPanel Margin="30">
            <TextBlock Text="Panel de Control" FontSize="28" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,25"/>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Ellipse Width="80" Height="80" Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,20,0"
                             Fill="{Binding Dashboard.ProtectionBrush}"/>

                    <TextBlock Text="{Binding Dashboard.ProtectionStatus}" FontSize="22" FontWeight="SemiBold"
                               Foreground="#E0E0E0" Grid.Column="1" VerticalAlignment="Bottom"/>
                    <TextBlock Text="Sistema Asegurado" FontSize="14" Foreground="#81C784" 
                               Grid.Column="1" Grid.Row="1" Margin="0,5,0,0"/>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#0F3460" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{Binding Dashboard.TotalScans}" FontSize="32" FontWeight="Bold" Foreground="#4FC3F7"/>
                        <TextBlock Text="Escaneos" FontSize="13" Foreground="#CCC" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#0F3460" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{Binding Dashboard.ThreatsFound}" FontSize="32" FontWeight="Bold" Foreground="#FF5252"/>
                        <TextBlock Text="Amenazas" FontSize="13" Foreground="#CCC" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#0F3460" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{Binding Dashboard.QuarantinedItems}" FontSize="32" FontWeight="Bold" Foreground="#FFB74D"/>
                        <TextBlock Text="En cuarentena" FontSize="13" Foreground="#CCC" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#0F3460" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="{Binding Dashboard.LastScanDate}" FontSize="14" FontWeight="Bold" Foreground="#81C784" TextWrapping="Wrap"/>
                        <TextBlock Text="Último escaneo" FontSize="13" Foreground="#CCC" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#16213E" CornerRadius="12" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Uso de CPU (AI Local)" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Dashboard.CpuUsageText}" FontSize="36" FontWeight="Bold" Foreground="#4FC3F7"/>
                        <ProgressBar Value="{Binding Dashboard.CpuUsage}" Maximum="100" Height="8" 
                                     Foreground="#4FC3F7" Background="#333" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#16213E" CornerRadius="12" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Uso de RAM (AI Local)" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Dashboard.RamUsageText}" FontSize="36" FontWeight="Bold" Foreground="#81C784"/>
                        <ProgressBar Value="{Binding Dashboard.RamUsage}" Maximum="100" Height="8" 
                                     Foreground="#81C784" Background="#333" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Dashboard.RamDetailText}" FontSize="11" Foreground="#888" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Estado actual" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,15"/>

                    <Border Background="#0F3460" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Fill="#00C853" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Protección contra malware" FontSize="14" Foreground="#E0E0E0"/>
                                <TextBlock Text="Analizando archivos en tiempo real" FontSize="12" Foreground="#AAA"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="#0F3460" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Fill="#00C853" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Firewall de red" FontSize="14" Foreground="#E0E0E0"/>
                                <TextBlock Text="Monitoreando conexiones" FontSize="12" Foreground="#AAA"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="#0F3460" CornerRadius="8" Padding="15" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Actualización de bases" FontSize="14" Foreground="#E0E0E0"/>
                                <TextBlock Text="{Binding Dashboard.DefinitionsStatus}" FontSize="12" Foreground="#AAA" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Actualizar bases" 
                                    Command="{Binding Dashboard.UpdateDefinitionsCommand}"
                                    Style="{StaticResource SmallButton}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Background="#0F3460" CornerRadius="8" Padding="15" Margin="0,10,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Fill="{Binding Dashboard.DefenderColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Windows Defender" FontSize="14" Foreground="#E0E0E0"/>
                                <TextBlock Text="{Binding Dashboard.DefenderStatus}" FontSize="12" Foreground="#AAA" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Desactivar Defender"
                                    Command="{Binding DataContext.DisableDefenderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource DangerSmallButton}" VerticalAlignment="Center"
                                    Visibility="{Binding Dashboard.DefenderDisabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding Dashboard.ScanStatus}" FontSize="13" Foreground="#AAA" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,20"
                    BorderBrush="{Binding Dashboard.ShieldColorBrush}" BorderThickness="1"
                    Visibility="{Binding IsPlusActive, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Escudo de Defensa" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                        <Ellipse Width="12" Height="12" Fill="{Binding Dashboard.ShieldColorBrush}" 
                                 VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Dashboard.ShieldStatus}" FontSize="13" Foreground="#AAA" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Dashboard.ShieldLevel}" FontSize="12" Foreground="#FF5252" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Dashboard.UsbScanStatus}" FontSize="11" Foreground="#81C784" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Acerca de Secure AI" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                    <TextBlock Text="Secure AI es un asistente de seguridad local que protege tu equipo analizando archivos sospechosos, monitoreando amenazas y manteniendo tu sistema limpio. Opera 100% local, priorizando tu privacidad y control total." FontSize="13" Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Contacto:" FontSize="12" Foreground="#AAA"/>
                    <TextBlock FontSize="12" Margin="0,1,0,0">
                        <Hyperlink NavigateUri="mailto:agdala.sv@gmail.com" RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="#4FC3F7" TextDecorations="None">
                            agdala.sv@gmail.com
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="BTC:" FontSize="12" Foreground="#AAA" Margin="0,5,0,0"/>
                    <Border Background="#0F3460" CornerRadius="4" Padding="8,4" Margin="0,2,0,0" Cursor="Hand">
                        <TextBlock MouseDown="Btc_MouseDown" 
                                   Text="3L8f3v6BWwL7KBcb8AMZQ2bpE3ACne2EUf" 
                                   FontSize="11" Foreground="#FFB74D" FontFamily="Consolas"/>
                    </Border>
                    <TextBlock Text="(clic para copiar)" FontSize="10" Foreground="#666" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
