<UserControl x:Class="Secureia.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="#1a1a2e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="30,25,30,15">
            <TextBlock Text="Cuarentena" FontSize="28" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Actualizar" Command="{Binding Quarantine.RefreshCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                <Button Content="Vaciar cuarentena" Command="{Binding Quarantine.DeleteAllCommand}"
                        Style="{StaticResource DangerButton}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#16213E" CornerRadius="12" Margin="30,0,30,30">
            <ListView ItemsSource="{Binding Quarantine.Items}" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0F3460" CornerRadius="8" Padding="12" Margin="5,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding OriginalPath}" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" Grid.Row="0"/>
                                <TextBlock Text="{Binding ThreatName}" FontSize="12" Foreground="#FF5252" 
                                           Grid.Row="1" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding QuarantinedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" 
                                               FontSize="11" Foreground="#888" Margin="0,0,15,0"/>
                                    <TextBlock Text="{Binding FileSize, StringFormat={}{0:N0} bytes}" 
                                               FontSize="11" Foreground="#888"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" 
                                            VerticalAlignment="Center">
                                    <Button Content="Restaurar" 
                                            Command="{Binding DataContext.Quarantine.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource SmallButton}" Margin="0,0,5,0"/>
                                    <Button Content="Eliminar" 
                                            Command="{Binding DataContext.Quarantine.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource DangerSmallButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
