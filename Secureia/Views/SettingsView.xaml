<UserControl x:Class="Secureia.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer Background="#1a1a2e">
        <StackPanel Margin="30,25,30,30">
            <TextBlock Text="Configuración" FontSize="28" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,25"/>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,15"/>

                    <CheckBox Content="Iniciar con Windows" IsChecked="{Binding Settings.AutoStart}"
                              Foreground="#DDD" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="Nivel de notificaciones" FontSize="14" Foreground="#E0E0E0" Margin="0,0,0,8"/>
                    <ComboBox SelectedIndex="{Binding Settings.SelectedNotifyIndex}" 
                              Background="#0F3460" Foreground="White" BorderBrush="#555"
                              HorizontalAlignment="Left" Width="200">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4FC3F7" Opacity="0.7"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#0F3460"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="Silencioso"/>
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="Crítico"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Voz" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,15"/>

                    <CheckBox Content="Activar notificaciones por voz" IsChecked="{Binding Settings.VoiceEnabled}"
                              Foreground="#DDD" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="Volumen" FontSize="14" Foreground="#E0E0E0" Margin="0,0,0,5"/>
                    <Slider Value="{Binding Settings.VoiceVolume}" Minimum="0" Maximum="100" 
                            Width="300" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Settings.VoiceVolume, StringFormat='{}{0}%'}" 
                               FontSize="12" Foreground="#CCC"/>

                    <TextBlock Text="Voz" FontSize="14" Foreground="#E0E0E0" Margin="0,10,0,5"/>
                    <ComboBox ItemsSource="{Binding Settings.AvailableVoices}" 
                              SelectedItem="{Binding Settings.SelectedVoice}"
                              Background="#0F3460" Foreground="White" BorderBrush="#555"
                              HorizontalAlignment="Left" Width="250">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4FC3F7" Opacity="0.7"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#0F3460"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </Style.Resources>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Exclusiones" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,15"/>

                    <WrapPanel Margin="0,0,0,10">
                        <TextBox Text="{Binding Settings.NewExclusion, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="350" Background="#0F3460" Foreground="#E0E0E0" 
                                 BorderBrush="#333" BorderThickness="1" Padding="8" FontSize="13"/>
                        <Button Content="Examinar..." Command="{Binding Settings.BrowseExclusionCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                        <Button Content="Agregar" Command="{Binding Settings.AddExclusionCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                    </WrapPanel>

                    <ListView ItemsSource="{Binding Settings.Config.Exclusions}" 
                              Background="Transparent" BorderThickness="0" MaxHeight="150">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F3460" CornerRadius="6" Padding="10,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="#E0E0E0" 
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="#FF5252">
                                            <Button Content="X"
                                                    Command="{Binding DataContext.Settings.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="White" Background="Transparent" BorderThickness="0"
                                                    FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,15"
                    BorderBrush="#FFD700" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Secure AI Plus" FontSize="18" FontWeight="Bold" Foreground="#FFD700"/>
                        <Border Background="#FFD700" CornerRadius="3" Padding="6,2" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="PLUS" FontSize="10" FontWeight="Bold" Foreground="#1a1a2e"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Active las micro-AIs expertas para protección avanzada:" FontSize="13" Foreground="#CCC" Margin="0,0,0,5"/>
                    <TextBlock Text="• AI Experta en Malware (virus, troyanos, ransomware, rootkits)" FontSize="12" Foreground="#AAA" Margin="0,0,0,2"/>
                    <TextBlock Text="• AI Experta en Red (DoS, backdoors, conexiones remotas, escaneos)" FontSize="12" Foreground="#AAA" Margin="0,0,0,10"/>

                    <Border Background="#0F3460" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Estado:" FontSize="13" Foreground="#E0E0E0" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Settings.PlusStatus}" FontSize="13"
                                       Foreground="#81C784"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,0,0,10" Visibility="{Binding Settings.IsPlusActivated, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBox Text="{Binding Settings.PlusSerialInput, UpdateSourceTrigger=PropertyChanged}"
                                 Width="350" Background="#0F3460" Foreground="#E0E0E0"
                                 BorderBrush="#FFD700" BorderThickness="1" Padding="8" FontSize="13"
                                 FontFamily="Consolas"
                                 ToolTip="Ingrese el código de licencia (ej: ABCDE-FGHJK-LMNPQ-RSTUV-WXYZ2-34567)"/>
                        <Button Content="Activar Plus" Command="{Binding Settings.ActivatePlusCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                    </WrapPanel>

                    <Button Content="Desactivar Plus" Command="{Binding Settings.DeactivatePlusCommand}"
                            Style="{StaticResource DangerSmallButton}" HorizontalAlignment="Left"
                            Visibility="{Binding Settings.IsPlusActivated, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <Border Background="#16213E" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Acerca de / Apoyo" FontSize="18" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,10"/>
                    <TextBlock Text="Secure AI es un asistente de seguridad 100% local. Analiza archivos, detecta amenazas y protege tu privacidad sin depender de la nube." 
                               FontSize="13" Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Contacto:" FontSize="13" Foreground="#CCC" Margin="0,5,0,2"/>
                    <TextBlock FontSize="13" Margin="0,0,0,5">
                        <Hyperlink NavigateUri="mailto:agdala.sv@gmail.com"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="#4FC3F7" TextDecorations="None">
                            agdala.sv@gmail.com
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="BTC (invítame un café ☕):" FontSize="13" Foreground="#CCC" Margin="0,10,0,2"/>
                    <Border Background="#0F3460" CornerRadius="6" Padding="10" Margin="0,0,0,5" Cursor="Hand">
                        <TextBlock MouseDown="Btc_MouseDown" Text="3L8f3v6BWwL7KBcb8AMZQ2bpE3ACne2EUf" 
                                   FontSize="12" Foreground="#FFB74D" 
                                   FontFamily="Consolas" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="(clic para copiar)" FontSize="11" Foreground="#666" Margin="0,1,0,5"/>
                </StackPanel>
            </Border>

            <Button Content="Guardar configuración" Command="{Binding Settings.SaveCommand}"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Width="250" Height="44"
                    FontSize="15"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
